# One free Render web service = API + embedded queue worker (Render free has no background workers).
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY apps/worker/requirements.txt /app/apps/worker/requirements.txt
COPY apps/api/requirements.txt /app/apps/api/requirements.txt
RUN pip install --no-cache-dir -r /app/apps/worker/requirements.txt
COPY apps/api/app /app/apps/api/app
COPY apps/worker/worker /app/apps/worker/worker
COPY data/reference /app/data/reference
ENV PYTHONPATH=/app/apps/api:/app/apps/worker \
    RUN_EMBEDDED_WORKER=true \
    UPLOAD_DIR=/tmp/uploads \
    WORKER_STATUS_PATH=/tmp/worker_status.json \
    REFERENCE_INDEX_PATH=/app/data/reference/index.json
RUN mkdir -p /tmp/uploads
# Render injects $PORT. --proxy-headers so rate limiting sees real client IPs, not Render's proxy.
CMD ["sh", "-c", "uvicorn app.main:app --app-dir apps/api --host 0.0.0.0 --port ${PORT:-10000} --workers 1 --proxy-headers --forwarded-allow-ips='*'"]
