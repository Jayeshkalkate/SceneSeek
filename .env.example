# App
APP_ENV=development
DJANGO_SETTINGS_MODULE=sceneseek_project.settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,api
DB_CONN_MAX_AGE=60
DB_SSLMODE=require
APP_NAME=SceneSeek API
# Optional: redirect the API root URL to the deployed Next.js website.
FRONTEND_URL=
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_PER_MINUTE=10
READ_RATE_LIMIT_PER_MINUTE=180

# Local-first database; use PostgreSQL for multiple API/worker replicas.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Neon (free Postgres), e.g.: postgresql://USER:PASS@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Storage: local is the zero-credential default. Set all three Supabase values
# to use a private Supabase Storage bucket in a deployed setup.
UPLOAD_DIR=./data/uploads
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=26214400
MAX_VIDEO_SECONDS=30
UPLOAD_TTL_HOURS=24
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=uploads

# Reference index created by tools/index_reference.py
REFERENCE_INDEX_PATH=./data/reference/index.json

# Recognition. Index and query must use the same algorithm.
USE_PGVECTOR=false
METADATA_ENRICHMENT_ENABLED=true
METADATA_CACHE_HOURS=24
CLIP_MODEL=clip-ViT-B-32
ENABLE_OCR=false
ENABLE_ASR=false
# Free anime lookup via trace.moe + AniList (sends the frame to trace.moe). Set false to stay fully local.
ENABLE_ONLINE_ANIME=true
WORKER_POLL_SECONDS=2
JOB_LEASE_SECONDS=180
OMDB_API_KEY=

# Google sign-in (free). OAuth *Web* client; add your site URL under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# Long random string for signing session tokens (e.g. `openssl rand -hex 32`). Sign-in is off if empty.
JWT_SECRET=
REQUIRE_LOGIN=false
# Run the worker inside the API process (needed on Render free; local dev can keep a separate worker).
RUN_EMBEDDED_WORKER=false
# Optional override for container networking/local database
# DATABASE_URL_DOCKER=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
